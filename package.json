{
  "name": "dsh-wenmai",
  "version": "0.7.0",
  "description": "文脉 Wenmai — 文字工作者的编译型知识库，DeepSeek Harness 插件",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrislee121/wenmai.git"
  },
  "bugs": {
    "url": "https://github.com/chrislee121/wenmai/issues"
  },
  "homepage": "https://github.com/chrislee121/wenmai#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "prepare": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && tsdown && node --test tests/*.test.mjs",
    "accept": "tsc -p tsconfig.json && tsdown && node scripts/accept-e2e.mjs",
    "release-check": "npm test && node scripts/accept-e2e.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wenmai",
    "wiki",
    "knowledge-base",
    "writing",
    "self-media"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "cose-base": "^2.2.0",
    "cytoscape": "^3.34.1",
    "cytoscape-fcose": "^2.2.0",
    "layout-base": "^2.0.1"
  }
}
